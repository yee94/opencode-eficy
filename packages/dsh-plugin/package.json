{
  "name": "@eficy/dsh-plugin",
  "version": "0.2.0",
  "description": "Eficy interactive TSX previews, reports, skills and export for DeepSeek Harness",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yee94/opencode-eficy.git",
    "directory": "packages/dsh-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "eficy",
    "preview",
    "tsx"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "skills",
    "samples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-dsh-plugin.mjs"
  },
  "dependencies": {
    "sucrase": "3.35.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1"
  }
}
