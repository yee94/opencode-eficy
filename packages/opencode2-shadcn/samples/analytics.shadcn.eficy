import { signal, computed, component } from 'eficy';
import * as ui from 'https://cdn.jsdelivr.net/npm/@eficy/shadcn-ui@1.1.3/dist/index.js';
import 'https://cdn.jsdelivr.net/npm/@eficy/shadcn-ui@1.1.3/dist/index.css';
import { AreaChart, Area, BarChart, Bar, CartesianGrid, XAxis, YAxis, Tooltip as ChartTooltip } from 'https://esm.sh/recharts@2.15.4?external=react,react-dom';
import { Compass, LayoutDashboard, ShoppingBag, Repeat, ArrowUpRight, Search, CalendarDays, Users, CreditCard, MousePointerClick, Receipt } from 'https://esm.sh/lucide-react@0.468.0?external=react';

const { Button, Badge, Card, CardHeader, CardTitle, CardDescription, CardContent, Input, Select, SelectTrigger, SelectValue, SelectContent, SelectItem, Tabs, TabsList, TabsTrigger, TabsContent, Table, TableHeader, TableBody, TableRow, TableHead, TableCell, ChartContainer, ChartTooltipContent } = ui;

const period = signal('28');
const business = signal('all');
const metric = signal('revenue');
const query = signal('');
const status = signal('all');
const businessNames = { all: '全部业务', store: '在线商店', subscription: '订阅业务' };
const money = (value) => new Intl.NumberFormat('zh-CN', { style: 'currency', currency: 'CNY', maximumFractionDigits: 0 }).format(value);
const number = (value) => new Intl.NumberFormat('zh-CN').format(value);
const days = computed(() => Number(period.value));
const dateLabel = computed(() => `2026.10.${29 - days.value} – 10.28`);
const factor = computed(() => business.value === 'store' ? 0.64 : business.value === 'subscription' ? 0.36 : 1);
const trend = computed(() => Array.from({ length: days.value }, (_, index) => {
  const day = 29 - days.value + index;
  const wave = [0, 620, 310, 1120, 760, 1680, 1230][(day - 1) % 7];
  const revenue = Math.round((3200 + day * 98 + wave) * factor.value);
  const orders = Math.round((31 + day * 1.2 + wave / 80) * factor.value);
  return { date: `10/${day}`, revenue, orders, previousRevenue: Math.round(revenue / 1.184), previousOrders: Math.round(orders / 1.126), visitors: Math.round(orders * (31 + (day % 3))) };
}));
const totals = computed(() => trend.value.reduce((sum, day) => ({ revenue: sum.revenue + day.revenue, orders: sum.orders + day.orders, visitors: sum.visitors + day.visitors, previousRevenue: sum.previousRevenue + day.previousRevenue, previousOrders: sum.previousOrders + day.previousOrders }), { revenue: 0, orders: 0, visitors: 0, previousRevenue: 0, previousOrders: 0 }));
const growth = computed(() => ((totals.value.revenue / totals.value.previousRevenue - 1) * 100).toFixed(1));
const sourceData = computed(() => {
  const shares = business.value === 'subscription' ? [0.36, 0.31, 0.21, 0.12] : [0.44, 0.27, 0.18, 0.11];
  return ['自然搜索', '直接访问', '社交媒体', '推荐链接'].map((name, index) => ({ name, visitors: Math.round(totals.value.visitors * shares[index]), share: Math.round(shares[index] * 100) }));
});
const records = [
  { id: 'NS-2084', customer: '林予安', email: 'y.an@example.com', product: 'Studio 年度订阅', business: 'subscription', channel: '直接访问', amount: 1299, status: 'paid', day: 28 },
  { id: 'NS-2083', customer: '陈晓', email: 'chen.x@example.com', product: 'Field Notes 套装', business: 'store', channel: '自然搜索', amount: 268, status: 'paid', day: 28 },
  { id: 'NS-2082', customer: '周以宁', email: 'yining@example.com', product: 'Studio 月度订阅', business: 'subscription', channel: '推荐链接', amount: 129, status: 'pending', day: 27 },
  { id: 'NS-2081', customer: '许清', email: 'xu.q@example.com', product: 'Everyday 帆布包', business: 'store', channel: '社交媒体', amount: 189, status: 'paid', day: 26 },
  { id: 'NS-2080', customer: '江一舟', email: 'yizhou@example.com', product: 'Desk 桌面收纳', business: 'store', channel: '自然搜索', amount: 359, status: 'refunded', day: 25 },
  { id: 'NS-2079', customer: '吴闻', email: 'wuwen@example.com', product: 'Team 年度订阅', business: 'subscription', channel: '直接访问', amount: 3699, status: 'paid', day: 23 },
  { id: 'NS-2078', customer: '宋禾', email: 'song.he@example.com', product: 'Field Notes 套装', business: 'store', channel: '自然搜索', amount: 268, status: 'pending', day: 18 },
  { id: 'NS-2077', customer: '叶知秋', email: 'zhi.q@example.com', product: 'Studio 年度订阅', business: 'subscription', channel: '社交媒体', amount: 1299, status: 'refunded', day: 12 },
];
const statusNames = { paid: '已支付', pending: '待支付', refunded: '已退款' };
const visibleRecords = computed(() => records.filter(row => row.day >= 29 - days.value && (business.value === 'all' || row.business === business.value) && (status.value === 'all' || row.status === status.value) && `${row.id} ${row.customer} ${row.email} ${row.product}`.toLowerCase().includes(query.value.trim().toLowerCase())));
const resetFilters = () => { query.value = ''; status.value = 'all'; };
const revenueConfig = { revenue: { label: '本期收入', color: '#2563eb' }, previousRevenue: { label: '上期收入', color: '#94a3b8' }, orders: { label: '本期订单', color: '#2563eb' }, previousOrders: { label: '上期订单', color: '#94a3b8' } };
const trafficConfig = { visitors: { label: '访客', color: '#0d9488' } };

const ScopeFilter = component(() => <div className="ns-scope">
  <div aria-label="分析业务范围" className="ns-nav">
    {[{ id: 'all', Icon: LayoutDashboard }, { id: 'store', Icon: ShoppingBag }, { id: 'subscription', Icon: Repeat }].map(({ id, Icon }) => <Button key={id} id={`nav-${id}`} variant="ghost" className={`ns-nav-item ${business.value === id ? 'ns-active' : ''}`} aria-pressed={business.value === id} onClick={() => { business.value = id; }}><Icon size={17} aria-hidden="true" />{businessNames[id]}{business.value === id && <span className="ns-nav-dot" />}</Button>)}
  </div>
</div>);

const Metrics = component(() => {
  const t = totals.value;
  const items = [
    { label: '总收入', value: money(t.revenue), detail: `较上期增长 ${growth.value}%`, Icon: CreditCard, positive: true },
    { label: '支付订单', value: number(t.orders), detail: `上期 ${number(t.previousOrders)} 笔`, Icon: Receipt },
    { label: '独立访客', value: number(t.visitors), detail: '所选区间内的模拟访客', Icon: Users },
    { label: '支付转化率', value: `${(t.orders / t.visitors * 100).toFixed(2)}%`, detail: '支付订单 / 独立访客', Icon: MousePointerClick },
  ];
  return <section className="ns-metrics" aria-label="关键指标">{items.map(({ label, value, detail, Icon, positive }) => <Card className="ns-kpi" key={label}><CardContent className="ns-kpi-inner"><div className="ns-kpi-label">{label}<Icon size={17} aria-hidden="true" /></div><div className="ns-kpi-value">{value}</div><p className={positive ? 'ns-positive' : 'ns-muted'}>{positive && <ArrowUpRight size={14} aria-hidden="true" />}{detail}</p></CardContent></Card>)}</section>;
});

const TrendChart = component(() => {
  const isRevenue = metric.value === 'revenue';
  return <Card className="ns-chart-card"><CardHeader className="ns-card-header"><div><CardTitle className="ns-card-title">增长趋势</CardTitle><CardDescription>与前一个等长区间对比</CardDescription></div><Badge variant="outline">{days.value} 天</Badge></CardHeader><CardContent className="ns-chart-content">
    <Tabs value={metric.value} onValueChange={value => { metric.value = value; }}>
      <div className="ns-chart-toolbar"><TabsList aria-label="趋势指标"><TabsTrigger id="metric-revenue" value="revenue">收入</TabsTrigger><TabsTrigger id="metric-orders" value="orders">订单</TabsTrigger></TabsList><div className="ns-legend"><span><i style={{ background: '#2563eb' }} />本期</span><span><i style={{ background: '#94a3b8' }} />上期</span></div></div>
      <div className="ns-chart-total" aria-live="polite">{isRevenue ? money(totals.value.revenue) : `${number(totals.value.orders)} 笔`}<span>{isRevenue ? '所选区间总收入' : '所选区间支付订单'}</span></div>
      {['revenue', 'orders'].map(key => <TabsContent key={key} value={key} className="ns-trend-panel"><ChartContainer id={`northstar-${key}`} config={revenueConfig} style={{ height: 268, width: '100%', aspectRatio: 'auto' }} aria-label={key === 'revenue' ? '每日收入与上期收入面积图' : '每日支付订单与上期订单面积图'}>
        <AreaChart data={trend.value} margin={{ top: 12, right: 8, bottom: 0, left: -18 }} accessibilityLayer>
          <defs><linearGradient id={`ns-fill-${key}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#2563eb" stopOpacity={0.2} /><stop offset="100%" stopColor="#2563eb" stopOpacity={0.01} /></linearGradient></defs>
          <CartesianGrid vertical={false} stroke="var(--border)" strokeDasharray="3 4" />
          <XAxis dataKey="date" axisLine={false} tickLine={false} tickMargin={10} minTickGap={28} tick={{ fill: 'var(--muted-foreground)', fontSize: 11 }} />
          <YAxis axisLine={false} tickLine={false} tickMargin={8} width={62} tickFormatter={value => key === 'revenue' ? `${(value / 1000).toFixed(0)}k` : value} tick={{ fill: 'var(--muted-foreground)', fontSize: 11 }} />
          <ChartTooltip content={<ChartTooltipContent />} />
          <Area type="monotone" dataKey={key === 'revenue' ? 'previousRevenue' : 'previousOrders'} stroke="#94a3b8" strokeWidth={1.5} strokeDasharray="5 5" fill="transparent" isAnimationActive={false} />
          <Area type="monotone" dataKey={key} stroke="#2563eb" strokeWidth={2.5} fill={`url(#ns-fill-${key})`} isAnimationActive={false} />
        </AreaChart>
      </ChartContainer></TabsContent>)}
    </Tabs>
    <div className="ns-insight"><ArrowUpRight size={18} aria-hidden="true" /><span>收入比上期提升 <strong>{growth.value}%</strong>。<small>基于当前业务与时间区间的模拟数据。</small></span></div>
  </CardContent></Card>;
});

const Sources = component(() => <Card className="ns-chart-card"><CardHeader className="ns-card-header"><div><CardTitle className="ns-card-title">访客从哪里来</CardTitle><CardDescription>按获客渠道划分</CardDescription></div><Users size={18} className="ns-muted" aria-hidden="true" /></CardHeader><CardContent className="ns-chart-content">
  <div className="ns-source-total">{number(totals.value.visitors)}<span>独立访客</span></div>
  <ChartContainer id="northstar-sources" config={trafficConfig} style={{ height: 174, width: '100%', aspectRatio: 'auto' }} aria-label="各渠道访客数量柱状图"><BarChart data={sourceData.value} margin={{ top: 8, right: 2, bottom: 0, left: 2 }} accessibilityLayer><CartesianGrid vertical={false} stroke="var(--border)" strokeDasharray="3 4" /><XAxis dataKey="name" axisLine={false} tickLine={false} tickMargin={10} interval={0} tick={{ fill: 'var(--muted-foreground)', fontSize: 10 }} /><ChartTooltip content={<ChartTooltipContent />} /><Bar dataKey="visitors" fill="#0d9488" radius={[4, 4, 0, 0]} maxBarSize={40} isAnimationActive={false} /></BarChart></ChartContainer>
  <div className="ns-source-list">{sourceData.value.map((source, i) => <div key={source.name}><span><i style={{ opacity: 1 - i * 0.17 }} />{source.name}</span><strong>{number(source.visitors)}</strong><span className="ns-muted">{source.share}%</span></div>)}</div>
</CardContent></Card>);

const Orders = component(() => <Card className="ns-orders"><CardHeader className="ns-card-header"><div><CardTitle className="ns-card-title">交易明细</CardTitle><CardDescription>精选模拟记录，用于演示筛选；不作为上方汇总的计算来源。</CardDescription></div><Badge variant="secondary">{visibleRecords.value.length} 条</Badge></CardHeader><CardContent className="ns-orders-content">
  <div className="ns-table-tools"><div className="ns-search"><Search size={16} aria-hidden="true" /><Input id="order-search" aria-label="搜索客户、商品或订单号" placeholder="搜索客户、商品或订单号…" value={query.value} onChange={event => { query.value = event.target.value; }} /></div><Select value={status.value} onValueChange={value => { status.value = value; }}><SelectTrigger id="status-filter" aria-label="交易状态" className="ns-status-select"><SelectValue /></SelectTrigger><SelectContent><SelectItem value="all">全部状态</SelectItem><SelectItem value="paid">已支付</SelectItem><SelectItem value="pending">待支付</SelectItem><SelectItem value="refunded">已退款</SelectItem></SelectContent></Select><Button id="reset-filters" variant="ghost" disabled={!query.value && status.value === 'all'} onClick={resetFilters}>重置</Button></div>
  <Table><TableHeader><TableRow><TableHead>客户 / 订单</TableHead><TableHead>商品</TableHead><TableHead>来源</TableHead><TableHead>状态</TableHead><TableHead className="ns-align-right">金额</TableHead><TableHead className="ns-align-right">日期</TableHead></TableRow></TableHeader><TableBody>{visibleRecords.value.map(row => <TableRow key={row.id} data-order-id={row.id}><TableCell><div className="ns-customer"><span className="ns-customer-avatar">{row.customer.slice(0, 1)}</span><span><strong>{row.customer}</strong><small>{row.id}</small></span></div></TableCell><TableCell><strong className="ns-product">{row.product}</strong><small className="ns-cell-small">{businessNames[row.business]}</small></TableCell><TableCell className="ns-nowrap">{row.channel}</TableCell><TableCell><Badge variant="outline" className={`ns-status ns-status-${row.status}`}><span />{statusNames[row.status]}</Badge></TableCell><TableCell className="ns-align-right ns-amount">{money(row.amount)}</TableCell><TableCell className="ns-align-right ns-muted ns-nowrap">10 月 {row.day} 日</TableCell></TableRow>)}{visibleRecords.value.length === 0 && <TableRow><TableCell colSpan={6}><div className="ns-empty" role="status"><Search size={24} aria-hidden="true" /><strong>没有符合条件的交易</strong><p>试试其他关键词，或清除搜索和状态筛选。</p><Button variant="outline" onClick={resetFilters}>清除筛选</Button></div></TableCell></TableRow>}</TableBody></Table>
  <div className="ns-table-footer" aria-live="polite"><span>显示 {visibleRecords.value.length} 条记录 · {businessNames[business.value]}</span><span>金额单位：人民币</span></div>
</CardContent></Card>);

export default component(() => <div className="ns-app">
  <style>{`
    .ns-app{--ns-blue:#2563eb;--ns-green:#047857;display:grid;grid-template-columns:228px minmax(0,1fr);min-height:100vh;background:var(--background);color:var(--foreground);font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif;font-size:14px;line-height:1.5}
    .ns-app *{box-sizing:border-box}.ns-app button,.ns-app input{font-family:inherit}.ns-app :focus-visible{outline:2px solid #2563eb;outline-offset:3px}.ns-app svg{flex-shrink:0}.ns-muted{color:var(--muted-foreground)}
    .ns-sidebar{display:flex;flex-direction:column;padding:30px 16px 20px;border-right:1px solid var(--border);background:var(--sidebar);gap:24px}.ns-brand{display:flex;align-items:center;gap:10px;padding:0 8px;font-size:21px;font-weight:700;letter-spacing:-.7px}.ns-brand-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:#2563eb;color:white}.ns-brand small{display:block;font-size:10px;letter-spacing:.1px;font-weight:400;color:var(--muted-foreground);margin-top:1px}.ns-workspace{display:flex;align-items:center;gap:8px;padding:12px 8px;border:1px solid var(--border);border-radius:8px;font-size:11px}.ns-workspace>div{flex:1}.ns-workspace small,.ns-profile small{display:block;font-size:11px;color:var(--muted-foreground);margin-top:3px}.ns-avatar{display:grid;place-items:center;flex-shrink:0;width:30px;height:30px;background:var(--muted);border:1px solid var(--border);border-radius:7px;font-size:11px;font-weight:600}.ns-nav-label{font-size:11px;color:var(--muted-foreground);margin:0 10px -14px}.ns-nav{display:flex;flex-direction:column;gap:6px}.ns-app .ns-nav-item{display:flex;justify-content:flex-start;width:100%;gap:10px;height:42px;padding:0 12px;font-size:13px;font-weight:500;color:var(--muted-foreground);border-radius:7px}.ns-app .ns-nav-item.ns-active{color:#1d4ed8;background:#eff6ff}.ns-nav-dot{width:5px;height:5px;border-radius:50%;background:#2563eb;margin-left:auto}.ns-sidebar-note{margin-top:auto;border:1px solid var(--border);border-radius:8px;padding:13px;font-size:12px}.ns-sidebar-note p{font-size:11px;color:var(--muted-foreground);line-height:1.8;margin:7px 0 0}.ns-live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#0d9488;margin-right:7px}.ns-profile{display:flex;align-items:center;gap:10px;padding:0 8px;font-size:12px}
    .ns-main{min-width:0}.ns-topbar{height:64px;border-bottom:1px solid var(--border);padding:0 32px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px}.ns-breadcrumb{display:flex;align-items:center;gap:12px;color:var(--muted-foreground)}.ns-breadcrumb strong{color:var(--foreground);font-weight:500}.ns-topbar-note{color:var(--muted-foreground);display:flex;align-items:center;gap:10px}.ns-content{max-width:1440px;margin:auto;padding:30px 32px 24px}.ns-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:26px}.ns-heading h1{font-size:28px;line-height:1.2;font-weight:650;letter-spacing:-1px;margin:0 0 9px}.ns-heading p{font-size:12px;color:var(--muted-foreground);margin:0}.ns-period{display:flex;align-items:center;gap:10px}.ns-app .ns-period-trigger{min-width:132px;font-size:12px}.ns-period-date{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted-foreground)}
    .ns-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.ns-app .ns-kpi{box-shadow:none;padding:0;gap:0;border-radius:10px;min-width:0}.ns-app .ns-kpi-inner{padding:19px 20px}.ns-kpi-label{display:flex;align-items:center;justify-content:space-between;color:var(--muted-foreground);font-size:12px;gap:8px}.ns-kpi-value{font-size:28px;line-height:1.3;font-weight:650;font-variant-numeric:tabular-nums;letter-spacing:-1px;margin:12px 0 9px}.ns-kpi p{display:flex;align-items:center;gap:3px;margin:0;font-size:11px}.ns-positive{color:var(--ns-green)}.ns-chart-grid{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(270px,1fr);gap:20px;margin-bottom:22px}.ns-app .ns-chart-card,.ns-app .ns-orders{min-width:0;padding:0;gap:0;box-shadow:none;border-radius:10px}.ns-app .ns-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:21px 22px 18px}.ns-app .ns-card-title{font-size:14px;font-weight:600;line-height:1.5;margin:0 0 5px}.ns-card-header p{font-size:11px;line-height:1.6}.ns-app .ns-chart-content{padding:0 22px 18px;min-width:0}.ns-chart-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}.ns-legend{display:flex;gap:13px;color:var(--muted-foreground);font-size:10px}.ns-legend span{display:flex;align-items:center;gap:5px}.ns-legend i{width:7px;height:7px;display:inline-block;border-radius:50%}.ns-chart-total{font-size:26px;font-weight:600;letter-spacing:-.8px;margin:17px 0 3px;font-variant-numeric:tabular-nums}.ns-chart-total>span{font-size:10px;font-weight:400;letter-spacing:0;color:var(--muted-foreground);margin-left:10px}.ns-app .ns-trend-panel{margin-top:0;min-width:0}.ns-insight{display:flex;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--border);font-size:11px}.ns-insight>svg{color:var(--ns-green)}.ns-insight small{display:block;color:var(--muted-foreground);margin-top:3px;font-size:10px}.ns-source-total{font-size:26px;font-weight:600;letter-spacing:-.7px;margin:3px 0 15px;font-variant-numeric:tabular-nums}.ns-source-total span{font-size:11px;color:var(--muted-foreground);margin-left:10px;font-weight:400;letter-spacing:0}.ns-source-list{margin-top:15px}.ns-source-list>div{display:grid;grid-template-columns:1fr auto 35px;gap:14px;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:11px}.ns-source-list>div:last-child{border-bottom:0}.ns-source-list strong{font-variant-numeric:tabular-nums;font-weight:500}.ns-source-list i{display:inline-block;width:6px;height:6px;border-radius:50%;background:#0d9488;margin-right:8px}
    .ns-app .ns-orders-content{padding:0}.ns-table-tools{padding:0 22px 18px;display:flex;align-items:center;gap:10px}.ns-search{position:relative;max-width:340px;flex:1;min-width:0}.ns-search>svg{position:absolute;left:11px;top:11px;color:var(--muted-foreground)}.ns-search input{padding-left:34px;font-size:12px;height:38px}.ns-app .ns-status-select{width:130px;font-size:12px}.ns-table-tools button{font-size:12px}.ns-orders table{min-width:670px;width:100%}.ns-orders th{font-size:11px;color:var(--muted-foreground);font-weight:500;background:var(--muted);height:36px}.ns-orders td{font-size:12px;height:68px}.ns-orders td:first-child,.ns-orders th:first-child{padding-left:22px}.ns-orders td:last-child,.ns-orders th:last-child{padding-right:22px}.ns-customer{display:flex;align-items:center;gap:10px}.ns-customer-avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--muted);color:var(--muted-foreground);font-size:11px}.ns-customer strong{font-weight:500;font-size:12px}.ns-customer small,.ns-cell-small{display:block;font-size:10px;color:var(--muted-foreground);margin-top:3px}.ns-product{font-size:12px;font-weight:500}.ns-nowrap{white-space:nowrap}.ns-app .ns-align-right{text-align:right}.ns-amount{font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}.ns-app .ns-status{font-size:10px;font-weight:400;gap:5px;white-space:nowrap;padding:3px 7px}.ns-status>span{width:5px;height:5px;background:currentColor;border-radius:50%}.ns-app .ns-status-paid{background:#ecfdf5;color:#047857;border-color:#a7f3d0}.ns-app .ns-status-pending{background:#fffbeb;color:#92400e;border-color:#fde68a}.ns-app .ns-status-refunded{background:var(--muted);color:var(--muted-foreground);border-color:var(--border)}.ns-table-footer{display:flex;justify-content:space-between;gap:10px;padding:14px 22px;border-top:1px solid var(--border);font-size:10px;color:var(--muted-foreground)}.ns-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:32px;text-align:center}.ns-empty p{margin:0;color:var(--muted-foreground)}.ns-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted-foreground);font-size:10px;margin-top:20px}.ns-footer span:last-child{display:flex;align-items:center;gap:5px}
    .dark .ns-app{--ns-green:#6ee7b7}.dark .ns-app .ns-nav-item.ns-active{color:#93c5fd;background:#172554}.dark .ns-app .ns-nav-dot{background:#60a5fa}.dark .ns-app .ns-status-paid{background:#052e26;color:#6ee7b7;border-color:#065f46}.dark .ns-app .ns-status-pending{background:#38250b;color:#fcd34d;border-color:#854d0e}.dark .ns-app :focus-visible{outline-color:#93c5fd}
    .ns-app{width:100%;max-width:600px;margin-inline:auto;grid-template-columns:minmax(0,1fr)}.ns-sidebar{padding:16px;gap:14px;border-right:0;border-bottom:1px solid var(--border)}.ns-brand small{display:none}.ns-brand{padding:0;font-size:18px}.ns-brand-icon{width:30px;height:30px}.ns-nav{flex-direction:row;flex-wrap:wrap;gap:6px}.ns-app .ns-nav-item{width:auto;height:36px;font-size:12px;padding:0 10px}.ns-nav-dot,.ns-workspace,.ns-nav-label,.ns-sidebar-note,.ns-profile,.ns-period-date{display:none}.ns-topbar{height:46px;padding:0 16px}.ns-topbar-note>span{display:none}.ns-content{padding:22px 16px}.ns-heading{align-items:flex-start;gap:10px}.ns-heading h1{font-size:25px}.ns-heading p{max-width:240px;line-height:1.7;font-size:12px}.ns-period{padding-top:2px}.ns-app .ns-period-trigger{min-width:114px}.ns-metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ns-app .ns-kpi-inner{padding:16px}.ns-kpi-value{font-size:25px}.ns-kpi p{font-size:11px}.ns-chart-grid{grid-template-columns:minmax(0,1fr);gap:16px}.ns-app .ns-chart-content{padding-left:14px;padding-right:14px}.ns-app .ns-card-header{padding-left:16px;padding-right:16px}.ns-table-tools{padding:0 14px 16px;flex-wrap:wrap;gap:8px}.ns-search{flex-basis:100%;max-width:none}.ns-app .ns-status-select{flex:1}.ns-chart-total>span{display:block;margin:3px 0 0}.ns-footer{align-items:flex-start;flex-wrap:wrap}.ns-table-footer{padding:12px 14px;font-size:11px;flex-wrap:wrap}.ns-orders [data-slot="table-container"]{max-width:100%;overflow-x:auto}
    .ns-scope{margin-bottom:24px}.ns-summary{margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border)}.ns-summary h2{font-size:18px;line-height:1.5;margin:0 0 12px;font-weight:600}.ns-summary p{font-size:14px;line-height:1.85;margin:8px 0}.ns-summary strong{font-weight:600;font-variant-numeric:tabular-nums}
  `}</style>
  <main className="ns-main">
    <div className="ns-content"><section className="ns-heading"><div><h1>经营分析报告</h1><p>{dateLabel.value} · 模拟数据</p></div><div className="ns-period"><Select value={period.value} onValueChange={value => { period.value = value; }}><SelectTrigger id="period-select" aria-label="分析时间区间" className="ns-period-trigger"><SelectValue /></SelectTrigger><SelectContent><SelectItem value="7">最近 7 天</SelectItem><SelectItem value="28">最近 28 天</SelectItem></SelectContent></Select></div></section>
      <ScopeFilter />
      <section className="ns-summary" aria-label="分析结论"><h2>收入增长，主要流量来自自然搜索</h2><p>{businessNames[business.value]}在所选 {days.value} 天内收入为 <strong>{money(totals.value.revenue)}</strong>，较前一个等长区间增长 <strong>{growth.value}%</strong>。自然搜索占访客的 <strong>{sourceData.value[0].share}%</strong>，是当前最大的流量来源。</p><p className="ns-muted">建议继续观察自然搜索的支付转化；当前数据只反映流量构成，不能据此判断各渠道的收入贡献。</p></section>
      <Metrics /><section className="ns-chart-grid" aria-label="趋势与来源分析"><TrendChart /><Sources /></section><Orders />
      <footer className="ns-footer"><span>所有数据均为本地模拟，不代表真实经营表现。</span><span><Compass size={12} aria-hidden="true" />Northstar Analytics</span></footer>
    </div>
  </main>
</div>);
