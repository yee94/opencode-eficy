import { signal, computed, component } from 'eficy';
import * as ui from 'shadcn';

const { Card, CardContent, Button, Badge, Input, Select, SelectTrigger, SelectValue, SelectContent, SelectItem, Table, TableHeader, TableBody, TableRow, TableHead, TableCell, ChartContainer, ChartTooltip, ChartTooltipContent } = ui;
const { BarChart, Bar, PieChart, Pie, Cell, XAxis, CartesianGrid } = ui.Recharts;
const { Package, Search, Truck, CheckCircle, Clock, RotateCcw } = ui.Lucide;
const range = signal('14');
const status = signal('all');
const search = signal('');
const states = { waiting: '待发货', shipping: '运输中', done: '已签收', returned: '已退货' };
const colors = { waiting: 'var(--ops-waiting)', shipping: 'var(--ops-shipping)', done: 'var(--ops-done)', returned: 'var(--ops-returned)' };
const orders = [
  ['WH-1048', '林雨', '旅行收纳包', 2, 258, 'waiting', 28, '上海'],
  ['WH-1047', '沈清和', '轻量通勤背包', 1, 469, 'shipping', 28, '杭州'],
  ['WH-1046', '周行', '保温随行杯', 3, 387, 'waiting', 27, '深圳'],
  ['WH-1045', '陈小满', '旅行收纳包', 1, 129, 'done', 27, '成都'],
  ['WH-1044', '宋远', '轻量通勤背包', 2, 938, 'shipping', 26, '北京'],
  ['WH-1043', '何一', '桌面整理盒', 2, 178, 'done', 25, '广州'],
  ['WH-1042', '许青', '保温随行杯', 1, 129, 'returned', 23, '南京'],
  ['WH-1041', '江望', '旅行收纳包', 3, 387, 'done', 21, '苏州'],
  ['WH-1040', '吴禾', '轻量通勤背包', 1, 469, 'done', 19, '武汉'],
  ['WH-1039', '顾南', '桌面整理盒', 1, 89, 'returned', 16, '厦门'],
].map(([id, name, item, count, amount, state, day, region]) => ({ id, name, item, count, amount, state, day, region }));
const periodOrders = computed(() => orders.filter(order => order.day >= 29 - Number(range.value)));
const visible = computed(() => periodOrders.value.filter(order => (status.value === 'all' || order.state === status.value) && `${order.id} ${order.name} ${order.item} ${order.region}`.toLowerCase().includes(search.value.trim().toLowerCase())));
const counts = computed(() => Object.keys(states).map(key => ({ name: states[key], state: key, value: periodOrders.value.filter(order => order.state === key).length, fill: colors[key] })));
const daily = computed(() => Array.from({ length: Number(range.value) }, (_, i) => {
  const day = 29 - Number(range.value) + i;
  const rows = periodOrders.value.filter(order => order.day === day);
  return { date: `10/${day}`, orders: rows.length, items: rows.reduce((sum, order) => sum + order.count, 0) };
}));
const summary = computed(() => ({ total: periodOrders.value.length, waiting: periodOrders.value.filter(order => order.state === 'waiting').length, shipping: periodOrders.value.filter(order => order.state === 'shipping').length, done: periodOrders.value.filter(order => order.state === 'done').length }));
const amount = computed(() => visible.value.reduce((sum, order) => sum + order.amount, 0));
const money = value => `¥${value.toLocaleString('zh-CN')}`;
const reset = () => { search.value = ''; status.value = 'all'; };
const volumeConfig = { orders: { label: '订单数', color: '#2563eb' }, items: { label: '商品件数', color: '#93c5fd' } };
const statusConfig = { value: { label: '订单数' }, waiting: { label: '待发货', color: colors.waiting }, shipping: { label: '运输中', color: colors.shipping }, done: { label: '已签收', color: colors.done }, returned: { label: '已退货', color: colors.returned } };

export default component(() => <main className="ops">
  <style>{`
    .ops{max-width:1240px;margin:auto;padding:24px 32px;background:var(--background);color:var(--foreground);font:14px/1.5 system-ui,sans-serif;min-height:100vh}.ops *{box-sizing:border-box}.ops :focus-visible{outline:2px solid #2563eb;outline-offset:3px}.ops-top,.ops-heading,.ops-table-heading,.ops-kpi-label,.ops-table-footer,.ops-footer{display:flex;justify-content:space-between;align-items:center;gap:12px}.ops-top{border-bottom:1px solid var(--border);padding-bottom:20px}.ops-brand,.ops-legend,.ops-legend span,.ops-status-legend>div{display:flex;align-items:center;gap:8px}.ops-brand{font-size:17px;font-weight:650}.ops-brand>svg{color:#2563eb}.ops-top small,.ops-muted,.ops-subtitle,.ops-kpi-note,.ops-legend,.ops-status-legend,.ops-footer,.ops-table-footer{font-size:11px;color:var(--muted-foreground)}.ops-heading{padding:30px 0 24px}.ops h1{font-size:28px;letter-spacing:-1px;margin:0 0 8px}.ops-heading p{margin:0;color:var(--muted-foreground);font-size:12px}.ops .ops-range,.ops .ops-status-select{width:140px;font-size:12px}.ops-kpis,.ops-charts{display:grid;gap:16px;margin-bottom:20px}.ops-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.ops-charts{grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr)}.ops .ops-card{padding:0;gap:0;box-shadow:none;min-width:0}.ops .ops-kpi-body,.ops .ops-chart-body{padding:20px}.ops-kpi-label{font-size:12px;color:var(--muted-foreground)}.ops-kpi-value{font-size:30px;font-weight:600;margin:9px 0 4px;font-variant-numeric:tabular-nums}.ops h2{font-size:14px;font-weight:600;margin:0 0 5px}.ops-subtitle{margin:0 0 17px}.ops-legend{gap:16px;margin-bottom:12px}.ops i{display:inline-block;width:7px;height:7px;border-radius:50%}.ops-status-legend{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;margin-top:8px}.ops-status-legend strong{margin-left:auto;color:var(--foreground)}.ops-table-heading{padding:20px 20px 0}.ops-tools{display:flex;gap:10px;padding:16px 20px;align-items:center}.ops-search{position:relative;flex:1;max-width:380px;min-width:0}.ops-search>svg{position:absolute;left:11px;top:10px;color:var(--muted-foreground)}.ops-search input{padding-left:34px;font-size:12px}.ops table{min-width:650px;width:100%}.ops th{background:var(--muted);font-size:11px}.ops td{height:60px;font-size:12px}.ops td:first-child,.ops th:first-child{padding-left:20px}.ops td:last-child,.ops th:last-child{padding-right:20px}.ops .ops-right{text-align:right;white-space:nowrap}.ops-order-meta{font-size:10px;color:var(--muted-foreground);display:block;margin-top:3px}.ops .ops-state{font-size:10px;gap:5px;white-space:nowrap}.ops-state i{background:currentColor;width:5px;height:5px}.ops-table-footer{padding:14px 20px;border-top:1px solid var(--border)}.ops-empty{padding:32px;text-align:center}.ops-footer{margin-top:20px}
    .ops{--ops-waiting:#b45309;--ops-shipping:#2563eb;--ops-done:#0d9488;--ops-returned:#64748b;width:100%;min-width:0}.ops [data-slot="table-container"]{width:100%;max-width:100%;min-width:0;overflow-x:auto}.ops-heading>div{min-width:0}.ops .ops-range{flex-shrink:0}.dark .ops{--ops-waiting:#fbbf24;--ops-shipping:#60a5fa;--ops-done:#2dd4bf;--ops-returned:#cbd5e1}.dark .ops-brand>svg{color:#60a5fa}.dark .ops :focus-visible{outline-color:#93c5fd}
    .ops{max-width:600px;padding:16px;box-sizing:border-box}.ops-charts{grid-template-columns:minmax(0,1fr)}.ops-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ops .ops-kpi-body{padding:15px}.ops-top small{display:none}.ops-heading{align-items:flex-start;padding:24px 0 20px;gap:10px}.ops h1{font-size:25px}.ops-heading p{max-width:240px;font-size:12px}.ops .ops-range{width:115px}.ops-tools{flex-wrap:wrap;padding:14px}.ops-search{flex-basis:100%;max-width:none}.ops .ops-status-select{flex:1}.ops .ops-chart-body{padding:16px}.ops-table-heading{padding:16px 14px 0}.ops-table-footer{padding:12px 14px;font-size:11px;flex-wrap:wrap}.ops-footer{flex-direction:column;gap:5px}
    .ops-summary{margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border)}.ops-summary h2{font-size:18px;line-height:1.5;margin:0 0 12px}.ops-summary p{font-size:14px;line-height:1.85;margin:8px 0}.ops-summary strong{font-weight:600;font-variant-numeric:tabular-nums}
  `}</style>
  <section className="ops-heading"><div><h1>履约分析报告</h1><p>2026.10.{29 - Number(range.value)} – 10.28 · 模拟数据</p></div><Select value={range.value} onValueChange={value => { range.value = value; }}><SelectTrigger id="ops-period" className="ops-range" aria-label="订单时间区间"><SelectValue /></SelectTrigger><SelectContent><SelectItem value="7">最近 7 天</SelectItem><SelectItem value="14">最近 14 天</SelectItem></SelectContent></Select></section>
  <section className="ops-summary" aria-label="分析结论"><h2>先关注尚未完成履约的订单</h2><p>所选区间共有 <strong>{summary.value.total} 单</strong>，其中 <strong>{summary.value.waiting} 单待发货</strong>、<strong>{summary.value.shipping} 单运输中</strong>，已签收占比为 <strong>{(summary.value.done / summary.value.total * 100).toFixed(0)}%</strong>（分母包含退货订单）。</p><p className="ops-muted">建议结合承诺送达时间检查待发货与在途订单。当前样本没有时效字段，不能将未签收直接判为延误。</p></section>
  <section className="ops-kpis" aria-label="履约关键指标">{[{ label: '区间订单', value: summary.value.total, Icon: Package, note: '含退货订单' }, { label: '待发货', value: summary.value.waiting, Icon: Clock, note: '等待仓库处理' }, { label: '运输中', value: summary.value.shipping, Icon: Truck, note: '已交付承运商' }, { label: '已签收', value: summary.value.done, Icon: CheckCircle, note: '履约完成' }].map(({ label, value, Icon, note }) => <Card key={label} className="ops-card"><CardContent className="ops-kpi-body"><div className="ops-kpi-label">{label}<Icon size={16} aria-hidden="true" /></div><div className="ops-kpi-value">{value}<small style={{ fontSize: 12, fontWeight: 400, marginLeft: 7 }}>单</small></div><div className="ops-kpi-note">{note}</div></CardContent></Card>)}</section>
  <section className="ops-charts" aria-label="订单分析"><Card className="ops-card"><CardContent className="ops-chart-body"><h2>订单与商品量</h2><p className="ops-subtitle">10 月 {29 - Number(range.value)}–28 日 · 按下单日期统计</p><div className="ops-legend"><span><i style={{ background: '#2563eb' }} />订单数</span><span><i style={{ background: '#93c5fd' }} />商品件数</span></div><ChartContainer id="ops-volume" config={volumeConfig} style={{ height: 220, width: '100%', aspectRatio: 'auto' }} aria-label="每日订单数与商品件数柱状图"><BarChart data={daily.value} accessibilityLayer margin={{ top: 10, right: 0, left: 0, bottom: 0 }}><CartesianGrid vertical={false} stroke="var(--border)" strokeDasharray="3 4" /><XAxis dataKey="date" tickLine={false} axisLine={false} minTickGap={18} tick={{ fontSize: 10, fill: 'var(--muted-foreground)' }} /><ChartTooltip content={<ChartTooltipContent />} /><Bar dataKey="orders" fill="#2563eb" radius={[3, 3, 0, 0]} maxBarSize={22} isAnimationActive={false} /><Bar dataKey="items" fill="#93c5fd" radius={[3, 3, 0, 0]} maxBarSize={22} isAnimationActive={false} /></BarChart></ChartContainer></CardContent></Card>
    <Card className="ops-card"><CardContent className="ops-chart-body"><h2>履约状态分布</h2><p className="ops-subtitle">所选区间的全部订单，不受明细筛选影响</p><ChartContainer id="ops-status" config={statusConfig} style={{ height: 184, width: '100%', aspectRatio: 'auto' }} aria-label="订单履约状态环形图"><PieChart><ChartTooltip content={<ChartTooltipContent nameKey="state" hideLabel />} /><Pie data={counts.value} dataKey="value" nameKey="state" innerRadius={53} outerRadius={78} paddingAngle={3} stroke="var(--background)" strokeWidth={3} isAnimationActive={false}>{counts.value.map(item => <Cell key={item.state} fill={item.fill} />)}</Pie></PieChart></ChartContainer><div className="ops-status-legend">{counts.value.map(item => <div key={item.state}><i style={{ background: item.fill }} />{item.name}<strong>{item.value} 单</strong></div>)}</div></CardContent></Card>
  </section>
  <Card className="ops-card"><div className="ops-table-heading"><div><h2>订单队列</h2><span className="ops-muted">搜索和状态仅筛选下方明细</span></div><Badge variant="secondary">{visible.value.length} 单</Badge></div><div className="ops-tools"><div className="ops-search"><Search size={16} aria-hidden="true" /><Input id="ops-search" aria-label="搜索订单、收件人、商品或城市" placeholder="搜索订单、收件人、商品或城市" value={search.value} onChange={event => { search.value = event.target.value; }} /></div><Select value={status.value} onValueChange={value => { status.value = value; }}><SelectTrigger id="ops-state" className="ops-status-select" aria-label="履约状态"><SelectValue /></SelectTrigger><SelectContent><SelectItem value="all">全部状态</SelectItem>{Object.entries(states).map(([key, name]) => <SelectItem key={key} value={key}>{name}</SelectItem>)}</SelectContent></Select><Button id="ops-reset" variant="ghost" onClick={reset} disabled={!search.value && status.value === 'all'}><RotateCcw size={14} aria-hidden="true" />重置</Button></div>
    <Table><TableHeader><TableRow><TableHead>订单 / 日期</TableHead><TableHead>收件人</TableHead><TableHead>商品</TableHead><TableHead>状态</TableHead><TableHead className="ops-right">件数</TableHead><TableHead className="ops-right">订单金额</TableHead></TableRow></TableHeader><TableBody>{visible.value.map(order => <TableRow key={order.id} data-order-id={order.id}><TableCell><span className="ops-order-id">{order.id}</span><small className="ops-order-meta">2026-10-{order.day}</small></TableCell><TableCell>{order.name}<small className="ops-order-meta">{order.region}</small></TableCell><TableCell>{order.item}</TableCell><TableCell><Badge variant="outline" className="ops-state" style={{ color: colors[order.state] }}><i />{states[order.state]}</Badge></TableCell><TableCell className="ops-right">{order.count}</TableCell><TableCell className="ops-right">{money(order.amount)}</TableCell></TableRow>)}{!visible.value.length && <TableRow><TableCell colSpan={6}><div className="ops-empty" role="status"><strong>没有符合条件的订单</strong><p>换个关键词，或清除搜索与状态筛选。</p><Button variant="outline" onClick={reset}>清除筛选</Button></div></TableCell></TableRow>}</TableBody></Table>
    <div className="ops-table-footer" aria-live="polite"><span>样本 {visible.value.length} / {periodOrders.value.length} 单</span><span>筛选金额合计（含退货） <strong>{money(amount.value)}</strong></span></div>
  </Card>
  <footer className="ops-footer"><span>全部为本地模拟订单，不请求接口，不执行真实发货。</span><span>固定演示日期：2026 年 10 月 28 日</span></footer>
</main>);
