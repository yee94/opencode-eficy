{
  "name": "@eficy/opencode2-plugin",
  "version": "0.1.0",
  "description": "Self-contained Eficy previews for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yee94/opencode-eficy.git" },
  "homepage": "https://github.com/yee94/opencode-eficy#readme",
  "bugs": { "url": "https://github.com/yee94/opencode-eficy/issues" },
  "keywords": ["opencode", "opencode-plugin", "eficy", "preview", "tsx"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["src/index.ts", "src/parser.ts", "dist", "skills", "samples", "README.md"],
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:runtime && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && npm run typecheck && npm test",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "sucrase": "3.35.0"
  },
  "devDependencies": {
    "@eficy/browser": "1.2.4",
    "@eficy/shadcn-ui": "1.1.3",
    "@types/node": "24.3.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.25.12",
    "happy-dom": "20.11.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "solid-js": "1.9.15",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.1.11",
    "webpack": "5.112.2"
  }
}
