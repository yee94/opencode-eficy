{
  "name": "opencode-eficy-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Self-contained Eficy previews for OpenCode and DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yee94/opencode-eficy.git"
  },
  "homepage": "https://github.com/yee94/opencode-eficy#readme",
  "bugs": {
    "url": "https://github.com/yee94/opencode-eficy/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "eficy",
    "preview",
    "tsx"
  ],
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "pnpm build:runtime && turbo run build",
    "typecheck": "tsc --noEmit",
    "pack:all": "node scripts/pack-all.mjs",
    "smoke": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm typecheck && pnpm test && pnpm pack:all && pnpm smoke && changeset publish",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "sucrase": "3.35.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.1",
    "@eficy/browser": "1.2.4",
    "@eficy/shadcn-ui": "1.1.3",
    "@types/node": "24.3.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "effect": "4.0.1",
    "esbuild": "0.25.12",
    "happy-dom": "20.11.2",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "solid-js": "1.9.15",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.1.11",
    "webpack": "5.112.2"
  }
}
